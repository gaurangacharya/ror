- content_for :javascript do
  ST.initializeManageMembers();

- content_for :title_header do
  %h1
    = t("layouts.admin.admin")
    = "-"
    = t("admin.communities.premium_members.premium_members")

= render :partial => "admin/left_hand_navigation", :locals => { :links => admin_links_for(@current_community) }

.left-navi-section
  %h2= t("admin.communities.premium_members.premium_members", :community_name => @community.name(I18n.locale))

  %span#admin_members_count= page_entries_info(@people, :model => "Person").html_safe

  %form
    %table#admin_members_list
      %thead
        %tr
          %th= render partial: "layouts/sort_link", locals: { column: "name", direction: sort_link_direction("name"), title: t("admin.communities.manage_members.name") }
          %th= render partial: "layouts/sort_link", locals: { column: "email", direction: sort_link_direction("email"), title: t("admin.communities.manage_members.email") }
          %th= render partial: "layouts/sort_link", locals: { column: "join_date", direction: sort_link_direction("join_date"), title: t("admin.communities.manage_members.join_date") }
          %th= t("admin.communities.premium_members.member_id")
          %th= t("admin.communities.premium_members.membership_status")
          %th= t("admin.communities.premium_members.membership_until")
          %th= t("admin.communities.premium_members.referral_id")

      %tbody
        - @people.each do |member|
          - unless member.blank?
            %tr
              %td.admin-members-full-name
                = link_to [member.given_name, member.family_name].join(" "), member
              %td
                - confirmed_mail = member.confirmed_notification_email_addresses.first
                = member.guest? ? member.primary_email.address : confirmed_mail || member.emails.map(&:address).join(", ")
              %td= l(member.created_at, format: :short_date)
              %td= member.referral_id
              %td= member.premium_active? ? t("admin.communities.premium_members.active") : t("admin.communities.premium_members.inactive")
              %td
                = l(member.membership_expires_at.to_time, format: :short_date) if member.membership_expires_at
              %td= member.referrer_id
  .row
    .col-12
      = will_paginate @people
