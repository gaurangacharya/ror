- frontpage_fragment_cache("grid_item", listing) do
  .home-fluid-thumbnail-grid-item{id: "listing_#{listing.id}"}
    %div
      -# Listing image
      = render :partial => "layouts/grid_item_listing_image", :locals => {:listing => listing, :modifier_class => ""}

      -# Listing author details
      - is_hotel = @current_user&.is_hotel?
      .home-fluid-thumbnail-grid-author{class: is_hotel ? 'with-listing-qr-code' : ''}
        .home-fluid-thumbnail-grid-author-avatar
          = link_to(person_path(username: listing.author.username)) do
            = image_tag(listing.author.avatar.thumb || missing_avatar(:thumb, listing.author.is_vendor), :class => "home-fluid-thumbnail-grid-author-avatar-image")

        - distance = Maybe(listing.distance).or_else(nil)
        - name = PersonViewUtils.person_entity_display_name(listing.author, @current_community.name_display_type)
        .home-fluid-thumbnail-grid-details
          = link_to(person_path(username: listing.author.username), class: "home-fluid-thumbnail-grid-details-author-name", title: name) do
            = name
          = stars_rating_tag listing.author.rating_average, disable_after_rate: true, readonly: true, class: 'home-fluid-thumbnail-grid-details-author-rating'
        - if !listing.hide_price && (show_distance || distance.present?)
          - dist = format_distance(distance)
          - dist_string = "#{dist} #{listing.distance_unit}"
          .home-fluid-thumbnail-grid-details-distance{title: dist_string}
            = dist_string
        - if is_hotel
          .home-fluid-thumbnail-listing-qr-code
            - referral_id = "R-" + @current_user.username
            - url = listing.ext_booking_url || listing_url(listing.url, referral_id: referral_id)
            = link_qr_code(url, viewbox: true).html_safe

