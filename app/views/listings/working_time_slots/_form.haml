- time_slot = presenter.time_slot
- new_record = time_slot.new_record? || @error_list.present?
- date_from_params = params[:date].present? ? l(Time.zone.parse(params[:date]), format: :to_datepicker) : nil
- time_slot.date = new_record ? date_from_params : time_slot.start_time && l( time_slot.start_time, format: :to_datepicker)
.working-time-slot
  - if @presenter.listing.booking_per_day_or_night?
    %h2= new_record ? t('.new_date_slot') : t('.edit_date_slot')
  - else
    %h2= new_record ? t('.new_slot') : t('.edit_slot')

  = hidden_field_tag :selected_start_time, time_slot.start_time
  = hidden_field_tag :selected_end_time, time_slot.end_time

  - if @error_list.present?
    %div.flash-error
      = t("availability.some_dates_rejected")
      %ul
        - @error_list.each do |error|
          %li= error 

  - url = new_record ? listing_working_time_slots_path(listing_id: time_slot.listing.id) : listing_working_time_slot_path(listing_id: time_slot.listing.id, id: time_slot.id)
  = form_for(time_slot, url: url, remote: true) do |f|
    = f.hidden_field :id

    = f.label new_record ? t('.date_multi') : t('.date')
    = f.text_field :date, autocomplete: 'off'
    - if @presenter.listing.booking_per_day_or_night?
      = f.hidden_field :start_time, value: '00:00'
      = f.hidden_field :end_time, value: '24:00'
    - else
      .slot-row
        .slot-item
          = f.label t('.from')
          = f.select :start_time, '', { include_blank: true }

        .slot-item
          = f.label t('.till')
          = f.select :end_time, '', { include_blank: true }

    .row.submit
      .col-5
        = f.button t('.save'), :class => "send_button"
      - if !new_record
        .col-7.text-right
          = link_to listing_working_time_slot_path(listing_id: time_slot.listing.id, id: time_slot.id), method: :delete, class: 'button delete-slot', remote: true do
            = icon_tag('cross')
            = t(".delete")
