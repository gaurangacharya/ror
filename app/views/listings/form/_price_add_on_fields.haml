%fieldset.price_add_on_fields
  %legend= t('.legend')
  %a.price_add_on_delete{ href: '#', data: { confirm: t('.confirm') } }
    %i.ss-delete.icon-fix
  = f.hidden_field :id
  = f.hidden_field :_destroy, class: 'destroy'
  = f.hidden_field :currency
  = f.label :title
  = f.text_field :title
  = f.label :price
  = f.text_field :price, class: "price-field", maxlength: "10", placeholder: "0", value: (f.object.price ? f.object.price.to_s : nil)

