%fieldset.price_tax_fields
  %legend= t('.legend')
  %a.price_tax_delete{ href: '#', data: { confirm_message: t('.confirm') } }
    %i.ss-delete.icon-fix
  = f.hidden_field :id
  = f.hidden_field :_destroy, class: 'destroy'
  = f.hidden_field :person_id
  = f.label :title
  = f.text_field :title
  = f.label :percent
  = f.text_field :percent, class: "price-field", maxlength: "10", placeholder: "0"

