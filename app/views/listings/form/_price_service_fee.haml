.row
  .col-12
    %h2= t('.title')
    .row
      .col-12
        = form.label 'service_fee_ids'
        - service_fee_options = Listing::ServiceFee.for_person(current_person).collect { |fee| [ "#{fee.title} #{fee.percent}", fee.id ] }
        - default_option = service_fee_options.empty? ? ['Add a service fee', '', { disabled: true, selected: true }] : ['No service fee', '']
        = form.select 'service_fee_ids', [default_option] + service_fee_options, {}, { id: 'listing_service_fee_ids' }
    .row
      .col-12
        -#= form.fields_for :service_fees do |service_fees_fields|
          = render 'listings/form/price_service_fee_fields', f: service_fees_fields
        = link_to_add_fields t('.new'), form, :service_fees,
          { partial: 'listings/form/price_service_fee_fields',
            new_object: form.object.service_fees.build(person: form.object.author) },
          { class: 'button' }

