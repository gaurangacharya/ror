- content_for :extra_javascript do
  :javascript
    window.ST.initializeLocationSearch({
      form: '#hero__hero__0__search-form',
      search: '#hero__hero__0__search-form [name=lq]',
      status: '#hero__hero__0__search-form [name=ls]',
      coordinate: '#hero__hero__0__search-form [name=lc]',
      boundingbox: '#hero__hero__0__search-form [name=boundingbox]',
      maxDistance: '#hero__hero__0__search-form [name=distance_max]'
    })

    $(document).ready(function($) {
      $('.owl-carousel').owlCarousel({
        items: 1,
        mouseDrag: false,
        dots: true,
        nav: false,
        lazyLoad: true,
        autoplay: true,
        autoplayHoverPause: true
      });
    });

