# S3 Configuration for Asset Storage
# Copy these variables to your .env file or system environment

# Required: Your S3 bucket name
S3_BUCKET_NAME=your-bucket-name

# Required: AWS region where your bucket is located
S3_REGION=us-east-1

# Required: AWS credentials (create an IAM user with S3 access)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Optional: Cache control for assets (default: 1 year)
S3_CACHE_MAX_AGE=31536000

# Optional: CDN hostname if using CloudFront
# USER_ASSET_HOST=https://your-cdn-domain.com

# Optional: Upload bucket (can be same as S3_BUCKET_NAME)
S3_UPLOAD_BUCKET_NAME=your-bucket-name 